@startuml LOKI_Ket_noi_thiet_bi
 title Ket noi thiet bi HID
 actor "Khach / Game thu" as User
 boundary "path FE" as FE
 control "path BE" as BE
 participant "Browser WebHID" as WebHID
 participant "Thiet bi HID" as Device

 User -> FE : Chon ket noi thiet bi
 activate FE
 FE -> BE : Kiem tra trinh duyet va thiet bi ho tro
 activate BE
 BE --> FE : Tra ket qua kiem tra
 deactivate BE
 alt [WebHID kha dung]
   FE -> WebHID : requestDevice()
   alt [Nguoi dung cap quyen]
     activate WebHID
     WebHID -> Device : Hien thi yeu cau cap quyen
     activate Device
     Device --> WebHID : Tra thiet bi da chon
     WebHID -> Device : open()
     Device --> WebHID : Thiet bi san sang
     WebHID --> FE : Tra ket noi thanh cong
     deactivate Device
     deactivate WebHID
     FE --> User : Hien thi thiet bi da ket noi
   else [Nguoi dung huy hoac tu choi]
     activate WebHID
     WebHID -> Device : Hien thi yeu cau cap quyen
     activate Device
     Device --> WebHID : Tra ket qua huy / tu choi
     WebHID --> FE : Tra trang thai ket noi that bai
     deactivate Device
     deactivate WebHID
     FE --> User : Hien thi huong dan ket noi lai
   end
 else [WebHID khong kha dung]
   FE --> User : Yeu cau dung Chrome/Edge va HTTPS
 end
 deactivate FE
@enduml
