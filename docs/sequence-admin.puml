@startuml LOKI_Admin
 title Quan tri he thong
 actor "Quan tri vien" as Administrator
 boundary "path FE" as FE
 control "path BE" as BE
 participant "db/table\nusers, devices, profiles" as Tables
 database "CSDL" as DB

 Administrator -> FE : Mo trang quan tri
 activate FE
 FE -> BE : Gui yeu cau truy cap
 activate BE
 deactivate FE
 BE -> Tables : Kiem tra vai tro admin
 activate Tables
 Tables -> DB : SELECT role theo user_id
 activate DB
 DB --> Tables : Tra vai tro tai khoan
 deactivate DB
 Tables --> BE : Ket qua kiem tra quyen
 deactivate Tables
 alt [Tai khoan co quyen admin]
   BE -> Tables : Lay users, devices, profiles
   activate Tables
   Tables -> DB : SELECT du lieu quan tri
   activate DB
   DB --> Tables : Tra danh sach du lieu
   deactivate DB
   Tables --> BE : Du lieu quan tri
   deactivate Tables
   BE --> FE : Hien thi dashboard admin
  FE --> Administrator : Hien thi danh sach quan ly
  Administrator -> FE : Chon tao / sua / xoa ban ghi
   activate FE
   FE -> BE : Gui thao tac va du lieu thay doi
   BE -> Tables : Kiem tra quyen va cap nhat
   activate Tables
   Tables -> DB : INSERT / UPDATE / DELETE
   activate DB
   DB --> Tables : Tra ket qua cap nhat
   deactivate DB
   Tables --> BE : Tra trang thai thao tac
   deactivate Tables
   BE --> FE : Thong bao ket qua
  FE --> Administrator : Hien thi du lieu sau cap nhat
   deactivate FE
 else [Tai khoan khong co quyen admin]
   BE --> FE : Tu choi truy cap
  FE --> Administrator : Hien thi thong bao khong du quyen
 end
 deactivate BE
@enduml
