@startuml LOKI_Dang_ky
 title Dang ky tai khoan
 actor "Game thu" as Gamer
 boundary "path FE" as FE
 control "path BE" as BE
 participant "db/table\nusers, profiles" as Tables
 database "CSDL" as DB

 Gamer -> FE : Nhap email va mat khau
 activate FE
 FE -> BE : Gui yeu cau dang ky
 activate BE
 deactivate FE
 BE -> BE : Kiem tra du lieu dang ky
 BE -> Tables : Kiem tra email
 activate Tables
 Tables -> DB : SELECT users theo email
 activate DB
 DB --> Tables : Tra ket qua tim kiem
 deactivate DB
 Tables --> BE : Email da ton tai / chua ton tai
 deactivate Tables
 alt [Email chua ton tai]
   BE -> BE : Tao tai khoan Supabase Auth
   BE -> Tables : Luu user profile mac dinh
   activate Tables
   Tables -> DB : INSERT users, profiles
   activate DB
   DB --> Tables : Xac nhan da luu
   deactivate DB
   Tables --> BE : Ho so da tao
   deactivate Tables
   BE --> FE : Dang ky thanh cong
   FE --> Gamer : Hien thi ket qua dang ky
 else [Email da ton tai hoac du lieu khong hop le]
   BE --> FE : Tra thong bao loi
   FE --> Gamer : Yeu cau sua thong tin dang ky
 end
 deactivate BE
@enduml
